{
  "expo": {
    "name": "RNStarterKitExpo",
    "slug": "RNStarterKitExpo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codebasehub",
    "userInterfaceStyle": "automatic",
    "notification": {
      "icon": "./assets/images/favicon.png"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salika.RNStarterKitExpo", // TODO: change with your bundle id
      "associatedDomains": ["applinks:codebasehub.onelink.me"], // TODO: change with your onelink host from AppsFlyer
      "googleServicesFile": "./GoogleService-Info.plist", // TODO: find from GoogleService-Info.plist
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ExpoLocalization_supportsRTL": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.salika.RNStarterKitExpo", // TODO: change with your bundle id
              "app-1-387444732055-ios-0385d3a2645185d380b9d2" // TODO: find from GoogleService-Info.plist
            ]
          }
        ]
      },
      "appleTeamId": "32C4JWR5TY" // TODO: change with your apple team id
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.salika.RNStarterKitExpo",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "codebasehub.onelink.me", // TODO: change with your onelink host from AppsFlyer
              "pathPrefix": "/test1"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "codebasehub"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png", // TODO: change with your splash icon
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png", // TODO: change with your splash icon for dark mode
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "@react-native-firebase/messaging",
        {
          "presentationOptions": ["badge", "sound", "alert"]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-localization",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "expo-tracking-transparency",
      ["react-native-appsflyer", {}],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6370298270367230~3154264064", // TODO: change with your Mobile Ads App ID
          "iosAppId": "ca-app-pub-6370298270367230~7101789538", // TODO: change with your Mobile Ads App ID
          "skAdNetworkItems": [
