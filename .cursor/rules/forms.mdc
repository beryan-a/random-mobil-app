# Form Handling Standards

- Use react-hook-form for all form implementations
- Use yup for form validation schemas
- Create reusable form components
- Handle form errors consistently
- Include proper loading states

## Form Implementation Example

```tsx
import React from 'react';
import { View, Text } from 'react-native';
import { useForm, Controller } from 'react-hook-form';
import { yupResolver } from '@hookform/resolvers/yup';
import * as yup from 'yup';
import i18n from '@/services/i18n';
import { TextInput, Button } from '@/components';

// Validation schema
const schema = yup.object({
  email: yup.string().email(i18n.t('forms.errors.invalidEmail')).required(i18n.t('forms.errors.required')),
  password: yup.string().min(6, i18n.t('forms.errors.passwordMinLength')).required(i18n.t('forms.errors.required')),
});

interface LoginFormProps {
  onSubmit: (data: { email: string; password: string }) => void;
  isLoading?: boolean;
}

export const LoginForm = ({ onSubmit, isLoading = false }: LoginFormProps) => {
  const { control, handleSubmit, formState: { errors } } = useForm({
    resolver: yupResolver(schema),
    defaultValues: {
      email: '',
      password: '',
    },
  });

  return (
    <View className="w-full space-y-4">
      <Controller
        control={control}
        name="email"
        render={({ field: { onChange, value } }) => (
          <TextInput
            value={value}
            onChangeText={onChange}
            placeholder={i18n.t('forms.placeholders.email')}
            keyboardType="email-address"
            autoCapitalize="none"
            error={errors.email?.message}
          />
        )}
      />
      
      <Controller
        control={control}
        name="password"
        render={({ field: { onChange, value } }) => (
          <TextInput
            value={value}
            onChangeText={onChange}
            placeholder={i18n.t('forms.placeholders.password')}
            secureTextEntry
            error={errors.password?.message}
          />
        )}
      />
      
      <Button 
        title={i18n.t('forms.buttons.login')}
        onPress={handleSubmit(onSubmit)}
        isLoading={isLoading}
      />
    </View>
  );
};
